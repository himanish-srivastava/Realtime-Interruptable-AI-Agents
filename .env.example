# Copy to .env and fill in. Never commit real keys.
# LiveKit Cloud project (free tier works): https://cloud.livekit.io
# Use a project with no other agents deployed; the agent auto-joins every new room.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OpenAI: the agent's realtime model AND the benchmark's gpt-4o judge
OPENAI_API_KEY=
